---
import Layout from '../layouts/Layout.astro';
import Win98Window from '../components/Win98Window.astro';
---

<Layout title="To Do List – Windows 98">
  <!-- Desktop wrapper -->
  <div class="desktop">

    <!-- ===== MAIN WINDOW ===== -->
    <Win98Window
      title="To Do List"
      icon="🗒️"
      width="680px"
      showMinMax={true}
      statusText=""
    >
      <!-- Menu Bar -->
      <div slot="menu-bar" class="menubar">
        <button class="menubar-item" type="button" id="menu-file">File</button>
        <button class="menubar-item" type="button" id="menu-edit">Edit</button>
        <button class="menubar-item" type="button" id="menu-help">Help</button>
        <!-- Language switcher in menu bar -->
        <div class="menubar-lang">
          <span id="lang-label">Language:</span>
          <button class="btn-98 lang-btn" type="button" data-lang="en" id="btn-lang-en">🇺🇸 English</button>
          <button class="btn-98 lang-btn" type="button" data-lang="id" id="btn-lang-id">🇮🇩 Indonesia</button>
        </div>
      </div>

      <!-- ===== ADD / EDIT FORM ===== -->
      <fieldset class="form-group" id="task-form-fieldset">
        <legend id="form-legend">Add New Task</legend>

        <div class="form-row">
          <label for="input-title" id="label-title">Title:</label>
          <input
            type="text"
            id="input-title"
            class="input-98 input-title"
            maxlength="120"
            placeholder="Enter task title..."
            autocomplete="off"
          />
        </div>

        <div class="form-row">
          <label for="input-desc" id="label-desc">Description:</label>
          <input
            type="text"
            id="input-desc"
            class="input-98 input-desc"
            maxlength="240"
            placeholder="Optional description..."
            autocomplete="off"
          />
        </div>

        <div class="form-row form-row--actions">
          <div class="form-priority-row">
            <label for="select-priority" id="label-priority">Priority:</label>
            <select id="select-priority" class="input-98 select-priority">
              <option value="high">🔴 High</option>
              <option value="medium" selected>🟡 Medium</option>
              <option value="low">🔵 Low</option>
            </select>
          </div>

          <div class="form-btns">
            <input type="hidden" id="edit-id" value="" />
            <button type="button" id="btn-submit" class="btn-98 btn-primary">Add</button>
            <button type="button" id="btn-cancel" class="btn-98" style="display:none">Cancel</button>
          </div>
        </div>
      </fieldset>

      <!-- ===== FILTER & SORT TOOLBAR ===== -->
      <div class="toolbar">
        <!-- Filter buttons -->
        <div class="toolbar-group">
          <button class="btn-98 filter-btn active" data-filter="all">All</button>
          <button class="btn-98 filter-btn" data-filter="active">Active</button>
          <button class="btn-98 filter-btn" data-filter="completed">Completed</button>
        </div>

        <!-- Sort -->
        <div class="toolbar-group">
          <label id="label-sort">Sort by:</label>
          <select id="select-sort" class="input-98 select-sort">
            <option value="newest">Newest</option>
            <option value="oldest">Oldest</option>
            <option value="priority">Priority</option>
            <option value="alpha">A → Z</option>
          </select>
        </div>

        <!-- Bulk actions -->
        <div class="toolbar-group toolbar-group--right">
          <button type="button" id="btn-delete-completed" class="btn-98">🗑️ Delete Completed</button>
        </div>
      </div>

      <hr class="separator-98" />

      <!-- ===== TASK LIST ===== -->
      <div id="task-list-container" class="task-list-scroll">
        <div id="task-list"></div>
        <div id="empty-state" class="empty-state" style="display:none">
          <img src="/win98-empty.svg" alt="" width="48" height="48" onerror="this.style.display='none'" />
          <p id="empty-msg">No tasks yet. Add one above!</p>
        </div>
      </div>

      <!-- Stats in status bar (via slot statusText) -->
    </Win98Window>

    <!-- ===== TOAST NOTIFICATION ===== -->
    <div id="toast" class="toast" role="status" aria-live="polite"></div>

    <!-- ===== CONFIRM DIALOG ===== -->
    <div id="dialog-overlay" class="dialog-overlay" style="display:none" role="dialog" aria-modal="true">
      <div class="win98-window dialog-window">
        <div class="win98-titlebar">
          <div class="win98-titlebar-left">
            <span class="win98-titlebar-icon">⚠️</span>
            <span class="win98-titlebar-title" id="dialog-title">Confirm</span>
          </div>
        </div>
        <div class="win98-content dialog-content">
          <p id="dialog-msg"></p>
          <div class="dialog-actions">
            <button type="button" id="dialog-ok" class="btn-98 btn-primary">OK</button>
            <button type="button" id="dialog-cancel" class="btn-98">Cancel</button>
          </div>
        </div>
      </div>
    </div>

  </div><!-- /desktop -->
</Layout>

<!-- ============================================================
     CLIENT-SIDE SCRIPT
     All interactivity is managed here.
     The service layer (todoService) is inlined so Astro can
     bundle it without any extra configuration.
     ============================================================ -->
<script>
// ===== i18n =====
  type Lang = 'en' | 'id';
  const LANG_KEY = 'win98-lang';

  const translations = {
    en: {
      appTitle: 'To Do List',
      formAddTitle: 'Add New Task',
      formEditTitle: 'Edit Task',
      labelTitle: 'Title:',
      labelDesc: 'Description:',
      labelPriority: 'Priority:',
      priorityHigh: '🔴 High',
      priorityMedium: '🟡 Medium',
      priorityLow: '🔵 Low',
      btnAdd: 'Add',
      onSave: 'Save',
      onCancel: 'Cancel',
      filterAll: 'All',
      filterActive: 'Active',
      filterCompleted: 'Completed',
      sortBy: 'Sort by:',
      sortNewest: 'Newest',
      sortOldest: 'Oldest',
      sortPriority: 'Priority',
      sortAlpha: 'A → Z',
      btnDeleteCompleted: '🗑️ Delete Completed',
      noTasks: 'No tasks yet. Add one above!',
      noTasksFiltered: 'No tasks match the current filter.',
      btnEdit: '✏️ Edit',
      btnDelete: '🗑️ Delete',
      confirmDelete: 'Are you sure you want to delete this task?',
      confirmDeleteCompleted: 'Delete all completed tasks?',
      statusTotal: 'Total:',
      statusCompleted: 'Done:',
      statusPending: 'Pending:',
      langLabel: 'Language:',
      notifyAdded: 'Task added successfully.',
      notifyUpdated: 'Task updated.',
      notifyDeleted: 'Task deleted.',
      notifyToggled: 'Task status updated.',
      notifyDeletedCompleted: 'Completed tasks deleted.',
      dialogConfirm: 'Confirm',
      placeholderTitle: 'Enter task title...',
      placeholderDesc: 'Optional description...',
    },
    id: {
      appTitle: 'To Do List',
      formAddTitle: '{Nama Tugas Baru}',
      formEditTitle: 'Edit Tugas',
      labelTitle: 'Judul:',
      labelDesc: 'Deskripsi:',
      labelPriority: 'Prioritas:',
      priorityHigh: '🔴 Tinggi',
      priorityMedium: '🟡 Sedang',
      priorityLow: '🔵 Rendah',
      btnAdd: 'Nama',
      onSave: 'Simpan',
      onCancel: 'Batal',
      filterAll: 'Semua',
      filterActive: 'Aktif',
      filterCompleted: 'Selesai',
      sortBy: 'Urutkan:',
      sortNewest: 'Terbaru',
      sortOldest: 'Terlama',
      sortPriority: 'Prioritas',
      sortAlpha: 'A → Z',
      btnDeleteCompleted: '🗑️ Hapus Selesai',
      noTasks: 'Belum ada tugas. Tambahkan di atas!',
      noTasksFiltered: 'Tidak ada tugas yang cocok dengan filter.',
      btnEdit: '✏️ Edit',
      btnDelete: '🗑️ Hapus',
      confirmDelete: 'Yakin ingin mengapus tugas ini?',
      confirmDeleteCompleted: 'Hapus semua tugas yang sudah selesai?',
      statusTotal: 'Total:',
      statusCompleted: 'Selesai:',
      statusPending: 'Pending:',
      langLabel: 'Bahasa:',
      notifyAdded: 'Tugas Successfully ditambahkan.',
      notifyUpdated: 'Tugas Successfully diperbarui.',
      notifyDeleted: 'Tugas Successfully dihapus.',
      notifyToggled: 'Status tugas diperbarui.',
      notifyDeletedCompleted: 'Tugas selesai telah dihapus.',
      dialogConfirm: 'Konfirmasi',
      placeholderTitle: 'Masukkan judul tugas...',
      placeholderDesc: 'Deskripsi (opsional)...',
    },
  } as const;

  // ===== Todo Service (inline, ready to swap with fetch) =====
  interface Todo {
    id: string;
    title: string;
    description: string;
    completed: boolean;
    priority: 'low' | 'medium' | 'high';
    createdAt: string;
    updatedAt: string;
  }

  const STORAGE_KEY = 'win98-todos';

  const DUMMY: Todo[] = [
    { id:'1', title:'Learn Astro Framework', description:'Study island architecture and .astro components', completed:true,  priority:'high',   createdAt:'2026-10-28T08:00:00.000Z', updatedAt:'2026-10-29T10:00:00.000Z' },
    { id:'2', title:'Install Windows 98',    description:'Nostalgia with the legendary Microsoft OS',          completed:false, priority:'medium', createdAt:'2026-10-29T09:00:00.000Z', updatedAt:'2026-10-29T09:00:00.000Z' },
    { id:'3', title:'Build retro UI',        description:'Apply Windows 98 CSS to the Astro project',         completed:false, priority:'high',   createdAt:'2026-10-30T07:30:00.000Z', updatedAt:'2026-10-30T07:30:00.000Z' },
    { id:'4', title:'Buy a floppy disk',     description:'Find one at a vintage computer shop',               completed:false, priority:'low',    createdAt:'2026-10-31T11:00:00.000Z', updatedAt:'2026-10-31T11:00:00.000Z' },
    { id:'5', title:'Set up backend API',    description:'Create REST API to replace this dummy data',        completed:false, priority:'medium', createdAt:'2026-11-01T08:00:00.000Z', updatedAt:'2026-11-01T08:00:00.000Z' },
  ];

  function loadTodos(): Todo[] {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (raw) return JSON.parse(raw) as Todo[];
    } catch { /* ignore */ }
    saveTodos(DUMMY);
    return DUMMY;
  }
  function saveTodos(todos: Todo[]) { localStorage.setItem(STORAGE_KEY, JSON.stringify(todos)); }
  function genId() { return Date.now().toString(36) + Math.random().toString(36).slice(2,7); }

  const todoService = {
    getAll: (): Todo[] => loadTodos(),
    create(dto: Omit<Todo,'id'|'createdAt'|'updatedAt'>): Todo {
      const todos = loadTodos();
      const now = new Date().toISOString();
      const t: Todo = { ...dto, id: genId(), createdAt: now, updatedAt: now };
      todos.unshift(t);
      saveTodos(todos);
      return t;
    },
    update(id: string, dto: Partial<Omit<Todo,'id'|'createdAt'|'updatedAt'>>): Todo|null {
      const todos = loadTodos();
      const idx = todos.findIndex(t => t.id === id);
      if (idx === -1) return null;
      todos[idx] = { ...todos[idx], ...dto, updatedAt: new Date().toISOString() };
      saveTodos(todos);
      return todos[idx];
    },
    toggle(id: string): Todo|null {
      const todos = loadTodos();
      const t = todos.find(x => x.id === id);
      if (!t) return null;
      return todoService.update(id, { completed: !t.completed });
    },
    delete(id: string): boolean {
      const todos = loadTodos();
      const idx = todos.findIndex(t => t.id === id);
      if (idx === -1) return false;
      todos.splice(idx, 1);
      saveTodos(todos);
      return true;
    },
    deleteCompleted(): number {
      const todos = loadTodos();
      const before = todos.length;
      saveTodos(todos.filter(t => !t.completed));
      return before - loadTodos().length;
    },
    getStats() {
      const todos = loadTodos();
      const completed = todos.filter(t => t.completed).length;
      return { total: todos.length, completed, pending: todos.length - completed };
    },
  };

  // ===== App State =====
  let currentLang: Lang = (localStorage.getItem(LANG_KEY) as Lang) ?? 'en';
  let currentFilter: 'all' | 'active' | 'completed' = 'all';
  let currentSort: 'newest' | 'oldest' | 'priority' | 'alpha' = 'newest';
  let editingId: string | null = null;
  let pendingAction: (() => void) | null = null;

  // ===== DOM refs =====
  const $ = (id: string) => document.getElementById(id)!;
  const inputTitle   = $('input-title')   as HTMLInputElement;
  const inputDesc    = $('input-desc')    as HTMLInputElement;
  const selectPrio   = $('select-priority') as HTMLSelectElement;
  const editIdInput  = $('edit-id')       as HTMLInputElement;
  const btnSubmit    = $('btn-submit')    as HTMLButtonElement;
  const btnCancel    = $('btn-cancel')    as HTMLButtonElement;
  const btnDelComp   = $('btn-delete-completed') as HTMLButtonElement;
  const selectSort   = $('select-sort')   as HTMLSelectElement;
  const taskList     = $('task-list');
  const emptyState   = $('empty-state');
  const emptyMsg     = $('empty-msg');
  const toast        = $('toast');
  const dialogOverlay = $('dialog-overlay');
  const dialogMsg    = $('dialog-msg');
  const dialogOk     = $('dialog-ok');
  const dialogCancel = $('dialog-cancel');
  const dialogTitle  = $('dialog-title');

  // ===== Language =====
  function t() { return translations[currentLang]; }

  function applyLanguage() {
    const tr = t();

    // Update lang buttons active state
    document.querySelectorAll('.lang-btn').forEach(btn => {
      btn.classList.toggle('lang-btn--active', (btn as HTMLElement).dataset.lang === currentLang);
    });

    // Form legend + labels
    $('form-legend').textContent = editingId ? tr.formEditTitle : tr.formAddTitle;
    $('label-title').textContent = tr.labelTitle;
    $('label-desc').textContent  = tr.labelDesc;
    $('label-priority').textContent = tr.labelPriority;
    $('lang-label').textContent  = tr.langLabel;

    // Priority options
    const opts = selectPrio.options;
    opts[0].text = tr.priorityHigh;
    opts[1].text = tr.priorityMedium;
    opts[2].text = tr.priorityLow;

    // Submit / cancel buttons
    btnSubmit.textContent  = editingId ? tr.btnSave : tr.btnAdd;
    btnCancel.textContent  = tr.btnCancel;
    btnDelComp.textContent = tr.btnDeleteCompleted;

    // Filter buttons
    const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const filterLabels = [tr.filterAll, tr.filterActive, tr.filterCompleted];
    filterBtns.forEach((btn, i) => { btn.textContent = filterLabels[i]; });

    // Sort options
    $('label-sort').textContent = tr.sortBy;
    const sOpts = selectSort.options;
    sOpts[0].text = tr.sortNewest;
    sOpts[1].text = tr.sortOldest;
    sOpts[2].text = tr.sortPriority;
    sOpts[3].text = tr.sortAlpha;

    // Placeholders
    inputTitle.placeholder = tr.placeholderTitle;
    inputDesc.placeholder  = tr.placeholderDesc;

    // Re-render list to apply translated labels inside task cards
    renderList();
  }

  function setLang(lang: Lang) {
    currentLang = lang;
    localStorage.setItem(LANG_KEY, lang);
    applyLanguage();
  }

  // ===== Render =====
  const PRIORITY_ORDER = { high: 0, medium: 1, low: 2 };

  function getSortedFiltered(): Todo[] {
    let todos = todoService.getAll();

    // Filter
    if (currentFilter === 'active')    todos = todos.filter(t => !t.completed);
    if (currentFilter === 'completed') todos = todos.filter(t =>  t.completed);

    // Sort
    todos = [...todos].sort((a, b) => {
      if (currentSort === 'newest')   return new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime();
      if (currentSort === 'oldest')   return new Date(a.createdAt).getTime() - new Date(b.createdAt).getTime();
      if (currentSort === 'priority') return PRIORITY_ORDER[a.priority] - PRIORITY_ORDER[b.priority];
      if (currentSort === 'alpha')    return a.title.localeCompare(b.title);
      return 0;
    });

    return todos;
  }

  function priorityLabel(p: Todo['priority']): string {
    const tr = t();
    return p === 'high' ? tr.priorityHigh : p === 'medium' ? tr.priorityMedium : tr.priorityLow;
  }

  function formatDate(iso: string): string {
    return new Date(iso).toLocaleDateString(currentLang === 'id' ? 'id-ID' : 'en-US', {
      day: '2-digit', month: 'short', year: 'numeric',
    });
  }

  function renderList() {
    const todos = getSortedFiltered();
    const tr = t();

    if (todos.length === 0) {
      taskList.innerHTML = '';
      emptyState.style.display = 'flex';
      emptyMsg.textContent = todoService.getAll().length === 0 ? tr.noTasks : tr.noTasksFiltered;
    } else {
      emptyState.style.display = 'none';
      taskList.innerHTML = todos.map(todo => `
        <div class="task-item ${todo.completed ? 'task-item--done' : ''}"
             data-id="${todo.id}"
             data-completed="${todo.completed}"
             data-title="${escHtml(todo.title)}"
             data-description="${escHtml(todo.description)}"
             data-priority="${todo.priority}">

          <div class="task-item__main">
            <input type="checkbox"
              class="checkbox-98 task-toggle"
              ${todo.completed ? 'checked' : ''}
              data-id="${todo.id}"
              aria-label="Toggle ${escHtml(todo.title)}" />
            <div class="task-item__info">
              <span class="task-item__title ${todo.completed ? 'text-strikethrough' : ''}">${escHtml(todo.title)}</span>
              ${todo.description
                ? `<span class="task-item__desc ${todo.completed ? 'text-strikethrough' : ''}">${escHtml(todo.description)}</span>`
                : ''}
            </div>
          </div>

          <div class="task-item__meta">
            <span class="task-item__priority priority-${todo.priority}">${priorityLabel(todo.priority)}</span>
            <span class="task-item__date">${formatDate(todo.createdAt)}</span>
            <div class="task-item__actions">
              <button type="button" class="btn-98 btn-edit" data-id="${todo.id}">${tr.btnEdit}</button>
              <button type="button" class="btn-98 btn-delete" data-id="${todo.id}">${tr.btnDelete}</button>
            </div>
          </div>
        </div>
      `).join('');
    }

    updateStatusBar();
  }

  function escHtml(str: string): string {
    return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  function updateStatusBar() {
    const stats = todoService.getStats();
    const tr = t();
    const statusEl = document.getElementById('win98-status-text');
    const countEl  = document.getElementById('win98-status-count');
    if (statusEl) statusEl.textContent = `${tr.statusTotal} ${stats.total}  ${tr.statusPending} ${stats.pending}`;
    if (countEl)  countEl.textContent  = `${tr.statusCompleted} ${stats.completed}`;
  }

  // ===== Form helpers =====
  function resetForm() {
    editingId = null;
    editIdInput.value = '';
    inputTitle.value  = '';
    inputDesc.value   = '';
    selectPrio.value  = 'medium';
    btnCancel.style.display = 'none';
    const tr = t();
    $('form-legend').textContent = tr.formAddTitle;
    btnSubmit.textContent = tr.btnAdd;
    inputTitle.focus();
  }

  function startEdit(id: string) {
    const todo = todoService.getAll().find(t => t.id === id);
    if (!todo) return;
    editingId = id;
    editIdInput.value = id;
    inputTitle.value  = todo.title;
    inputDesc.value   = todo.description;
    selectPrio.value  = todo.priority;
    btnCancel.style.display = '';
    const tr = t();
    $('form-legend').textContent = tr.formEditTitle;
    btnSubmit.textContent = tr.btnSave;
    inputTitle.focus();
    inputTitle.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  // ===== Toast =====
  let toastTimer: ReturnType<typeof setTimeout>;
  function showToast(msg: string) {
    toast.textContent = msg;
    toast.classList.add('toast--show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => toast.classList.remove('toast--show'), 2500);
  }

  // ===== Confirm Dialog =====
  function showConfirm(msg: string, onOk: () => void) {
    dialogMsg.textContent = msg;
    dialogTitle.textContent = t().dialogConfirm;
    pendingAction = onOk;
    dialogOverlay.style.display = 'flex';
    dialogOk.focus();
  }

  function closeDialog() {
    dialogOverlay.style.display = 'none';
    pendingAction = null;
  }

  // ===== Event Listeners =====

  // Submit form (add / edit)
  btnSubmit.addEventListener('click', () => {
    const title = inputTitle.value.trim();
    if (!title) { inputTitle.focus(); return; }

    const dto = {
      title,
      description: inputDesc.value.trim(),
      priority: selectPrio.value as Todo['priority'],
      completed: false,
    };

    if (editingId) {
      todoService.update(editingId, { title: dto.title, description: dto.description, priority: dto.priority });
      showToast(t().notifyUpdated);
    } else {
      todoService.create(dto);
      showToast(t().notifyAdded);
    }

    resetForm();
    renderList();
  });

  // Enter key in inputs
  [inputTitle, inputDesc].forEach(el => {
    el.addEventListener('keydown', (e) => { if (e.key === 'Enter') btnSubmit.click(); });
  });

  // Cancel edit
  btnCancel.addEventListener('click', resetForm);

  // Delete completed
  btnDelComp.addEventListener('click', () => {
    showConfirm(t().confirmDeleteCompleted, () => {
      todoService.deleteCompleted();
      resetForm();
      renderList();
      showToast(t().notifyDeletedCompleted);
    });
  });

  // Sort change
  selectSort.addEventListener('change', () => {
    currentSort = selectSort.value as typeof currentSort;
    renderList();
  });

  // Filter buttons
  document.querySelectorAll<HTMLButtonElement>('.filter-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      currentFilter = btn.dataset.filter as typeof currentFilter;
      document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      renderList();
    });
  });

  // Language buttons
  document.querySelectorAll<HTMLButtonElement>('.lang-btn').forEach(btn => {
    btn.addEventListener('click', () => setLang(btn.dataset.lang as Lang));
  });

  // Task list: toggle / edit / delete (event delegation)
  taskList.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const id = target.dataset.id;
    if (!id) return;

    if (target.classList.contains('task-toggle')) {
      todoService.toggle(id);
      showToast(t().notifyToggled);
      renderList();
    } else if (target.classList.contains('btn-edit')) {
      startEdit(id);
    } else if (target.classList.contains('btn-delete')) {
      showConfirm(t().confirmDelete, () => {
        todoService.delete(id);
        if (editingId === id) resetForm();
        renderList();
        showToast(t().notifyDeleted);
      });
    }
  });

  // Dialog buttons
  dialogOk.addEventListener('click', () => {
    if (pendingAction) pendingAction();
    closeDialog();
  });
  dialogCancel.addEventListener('click', closeDialog);
  dialogOverlay.addEventListener('click', (e) => {
    if (e.target === dialogOverlay) closeDialog();
  });

  // ===== INIT =====
  applyLanguage();   // apply language and render the initial list
</script>

<style>
  /* ===== Desktop ===== */
  .desktop {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding: 32px 16px 48px;
    gap: 0;
  }

  /* ===== Menu Bar ===== */
  .menubar {
    display: flex;
    align-items: center;
    gap: 0;
    background-color: var(--win98-gray);
    border-bottom: 1px solid var(--win98-btn-shadow);
    padding: 1px 4px;
    flex-wrap: wrap;
  }

  .menubar-item {
    padding: 2px 8px;
    font-family: inherit;
    font-size: 11px;
    background: transparent;
    border: 1px solid transparent;
    cursor: pointer;
    color: var(--win98-black);
  }

  .menubar-item:hover,
  .menubar-item:focus {
    background-color: var(--win98-selection);
