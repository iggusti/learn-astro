---
/**
 * TaskItem.astro
 * Renders a single todo item in the task list.
 * Server-rendered; interactivity (edit/delete/toggle) is handled
 * by the client-side script in index.astro.
 */
import type { Todo } from '../services/todoService';

export interface Props {
  todo: Todo;
}

const { todo } = Astro.props;

const priorityLabel: Record<Todo['priority'], string> = {
  low:    '🔵 Low',
  medium: '🟡 Medium',
  high:   '🔴 High',
};

const priorityClass: Record<Todo['priority'], string> = {
  low:    'priority-low',
  medium: 'priority-medium',
  high:   'priority-high',
};

// Format the creation date in short locale format
const createdDate = new Date(todo.createdAt).toLocaleDateString('en-US', {
  day: '2-digit', month: 'short', year: 'numeric',
});
---

<div
  class:list={['task-item', todo.completed && 'task-item--done']}
  data-id={todo.id}
  data-completed={todo.completed.toString()}
  data-title={todo.title}
  data-description={todo.description}
  data-priority={todo.priority}
>
  <!-- Checkbox + Title -->
  <div class="task-item__main">
    <input
      type="checkbox"
      class="checkbox-98 task-toggle"
      checked={todo.completed}
      aria-label={`Toggle: ${todo.title}`}
      data-id={todo.id}
    />

    <div class="task-item__info">
      <span class:list={['task-item__title', todo.completed && 'text-strikethrough']}>
        {todo.title}
      </span>
      {todo.description && (
        <span class:list={['task-item__desc', todo.completed && 'text-strikethrough']}>
          {todo.description}
        </span>
      )}
    </div>
  </div>

  <!-- Meta + Actions -->
  <div class="task-item__meta">
    <span class:list={['task-item__priority', priorityClass[todo.priority]]}>
      {priorityLabel[todo.priority]}
    </span>
    <span class="task-item__date">{createdDate}</span>

    <div class="task-item__actions">
      <button
        type="button"
        class="btn-98 btn-edit"
        data-id={todo.id}
        title="Edit task"
        aria-label="Edit"
      >✏️ Edit</button>
      <button
        type="button"
        class="btn-98 btn-delete"
        data-id={todo.id}
        title="Delete task"
        aria-label="Delete"
      >🗑️ Delete</button>
    </div>
  </div>
</div>

<style>
  .task-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 6px;
    background-color: var(--win98-white);
    border-bottom: 1px solid var(--win98-gray);
    /* Sunken inset */
    box-shadow:
      inset 1px 1px 0 var(--win98-btn-shadow),
      inset -1px -1px 0 var(--win98-btn-highlight);
    margin-bottom: 3px;
    transition: background-color 0.1s;
  }

  .task-item:hover {
    background-color: #f0f0f0;
  }

  .task-item--done {
    background-color: #f8f8f8;
    opacity: 0.75;
  }

  /* Main row: checkbox + text */
  .task-item__main {
    display: flex;
    align-items: flex-start;
    gap: 6px;
  }

  .task-item__info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    flex: 1;
  }

  .task-item__title {
    font-size: 11px;
    font-weight: bold;
    word-break: break-word;
  }

  .task-item__desc {
    font-size: 10px;
    color: var(--win98-darker);
    word-break: break-word;
  }

  /* Meta row: priority + date + actions */
  .task-item__meta {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-left: 19px; /* align with title (checkbox width + gap) */
    flex-wrap: wrap;
  }

  .task-item__priority {
    font-size: 10px;
    padding: 0 4px;
  }

  .priority-high   { color: #cc0000; font-weight: bold; }
  .priority-medium { color: #996600; }
  .priority-low    { color: #006699; }

  .task-item__date {
    font-size: 10px;
    color: var(--win98-dark);
  }

  .task-item__actions {
    display: flex;
    gap: 3px;
    margin-left: auto;
  }

  .btn-edit,
  .btn-delete {
    font-size: 10px;
    min-width: 0;
    padding: 1px 6px;
    min-height: 18px;
  }
</style>
